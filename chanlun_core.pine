    tooltip="过滤价格变化不足的噪音笔，0=不过滤。建议 A股个股 0.5-1.0%，ETF 0.2-0.5%")
bool  showBiLabelInput      = input.bool(false, "显示笔信息标签", group="笔设置",
    tooltip="在每笔终点显示K线数和价格变化百分比")

// --- 中枢设置 (M3) ---
int   minStrokesForZSInput  = input.int(3,    "中枢最少笔数", minval=3, maxval=10, group="中枢设置",
    tooltip="构成中枢至少需要的笔数，禅师原文=3")
float minZSWidthInput       = input.float(0.0, "中枢最小宽度 (%)", minval=0.0, maxval=10.0, step=0.1, group="中枢设置",
    tooltip="过滤掉 ZG-ZD 过窄的伪中枢，0=不过滤。建议 0.1-0.3%")
bool  showZSLevelInput      = input.bool(false, "显示中枢级别", group="中枢设置",
    tooltip="在中枢框上标注包含的笔数")

// --- MACD 设置 (M4) ---
int  macdFastInput     = input.int(12, "MACD 快线", minval=2, maxval=50, group="MACD / 背驰")
int  macdSlowInput     = input.int(26, "MACD 慢线", minval=5, maxval=100, group="MACD / 背驰")
int  macdSignalInput   = input.int(9,  "MACD 信号线", minval=2, maxval=50, group="MACD / 背驰")
bool macdAbsoluteInput = input.bool(false, "MACD 绝对值面积", group="MACD / 背驰",
    tooltip="开启=取MACD柱的绝对值面积比较；关闭=保留正负符号")

// --- 背驰设置 (M4) ---
float areaRatioThresholdInput = input.float(0.8, "背驰面积比阈值", minval=0.1, maxval=1.0, step=0.05, group="MACD / 背驰",
    tooltip="当前笔面积/参考笔面积 < 此值 = 背驰。0.8=衰竭到原来的80%以下")
bool  showBeiChiInput         = input.bool(true, "显示背驰信号", group="MACD / 背驰")
bool  showConsolidationBCInput = input.bool(false, "显示盘整背驰", group="MACD / 背驰",
    tooltip="盘整背驰信号较多，默认关闭以减少图表干扰")

// --- 买卖点设置 (M5) ---
bool showBuySignalsInput  = input.bool(true, "显示买点 (B1/B2/B3)", group="买卖点设置")
bool showSellSignalsInput = input.bool(true, "显示卖点 (S1/S2/S3)", group="买卖点设置")
int  minSignalBarsInput   = input.int(10, "同类型信号最小间距 (K线)", minval=1, maxval=500, group="买卖点设置",
    tooltip="两个同类型信号之间的最少K线数，避免信号过密。1=不过滤，500=极度稀疏")
bool showB2Input          = input.bool(true, "显示第二类买卖点 (B2/S2)", group="买卖点设置")
bool showB3Input          = input.bool(true, "显示第三类买卖点 (B3/S3)", group="买卖点设置")

// --- 预判设置 (M6) ---
bool showPredictionInput = input.bool(true, "显示预判面板", group="预判设置",
    tooltip="在图表右上角显示实时预判表格，仅在盘中实时K线时更新")
