//@version=6
// 缠论核心 v0.8.0 - M6: 实时预判引擎
// 遵循禅师原文"教你炒股票"系列定义

indicator("缠论 - 分型与笔 [Chanlun Core]", "缠论核心", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ============================================================
// ENUMS
// ============================================================

// @description 包含处理的趋势方向：向上（取高高+低高）或向下（取低低+高低）
enum TrendDirection
    UP          // 向上趋势，合并取高高+低高
    DOWN        // 向下趋势，合并取高低+低低

// @description 分型类型：顶分型 / 底分型 / 无分型（三态，"尚未成立"用 NONE 替代 na）
enum FractalType
    NONE        // 无分型（用于三态，替代 boolean na）
    TOP         // 顶分型
    BOTTOM      // 底分型

// @description 笔的方向：向上笔（底分型→顶分型，价格上涨）或向下笔（顶分型→底分型，价格下跌）
enum StrokeDirection
    UP          // 向上笔：底分型 → 顶分型
    DOWN        // 向下笔：顶分型 → 底分型

// ============================================================
// USER-DEFINED TYPES
// ============================================================

// @description 包含处理后的K线。一根逻辑K线可能对应多根原始K线
// @field originalIndex 对应原始K线序列的第一根索引
// @field mergedCount  合并了多少根原始K线（1 = 无合并）
// @field high         合并后的高点
// @field low          合并后的低点
// @field open         第一根原始K线的open
// @field close        最后一根原始K线的close
// @field direction    合并时的趋势方向 (TrendDirection enum 的 int 值)
type MergedBar
    int            originalIndex
    int            mergedCount
    float          high
    float          low
    float          open
    float          close
    TrendDirection direction

// @description 分型：缠论最基础的几何单元，所有上层结构（笔、线段、中枢）都从分型开始
// @field barIndex      分型在合并后K线序列中的索引
// @field originalIndex 对应的第一根原始K线索引（用于画图定位）
// @field price         顶分型 = 合并后K线的高点, 底分型 = 合并后K线的低点
// @field fType         分型方向: TOP or BOTTOM
type Fractal
    int         barIndex
    int         originalIndex
    float       price
    FractalType fType

// @description 笔：连接两个交替分型的线段，缠论趋势的基本单元
// @field startOrigIndex 起点对应原始K线 bar_index
// @field endOrigIndex   终点对应原始K线 bar_index
// @field startPrice     起点价格（底分型=low，顶分型=high）
// @field endPrice       终点价格
// @field dir            笔的方向 (UP=底→顶, DOWN=顶→底)
// @field barCount       跨越的原始K线数量（含两端分型K线）
// @field priceChange    价格变化幅度（绝对值）
// @field priceChangePct 价格变化百分比
type Stroke
    int             startOrigIndex
    int             endOrigIndex
    float           startPrice
    float           endPrice
    StrokeDirection dir
    int             barCount
    float           priceChange
    float           priceChangePct

// @description 中枢：至少三段连续笔的价格重叠区间，缠论的核心概念
// @field startStrokeIdx  起始笔在 strokes 数组中的索引
// @field endStrokeIdx    结束笔在 strokes 数组中的索引
// @field startOrigIndex  中枢起始对应的原始K线 bar_index（第一笔起点）
// @field endOrigIndex    中枢结束对应的原始K线 bar_index（最后一笔终点）
// @field zg              中枢高点 ZG = min(构成中枢各笔的高点)
// @field zd              中枢低点 ZD = max(构成中枢各笔的低点)
// @field gg              区间最高 GG = max(构成中枢各笔的高点)
// @field dd              区间最低 DD = min(构成中枢各笔的低点)
// @field strokeCount     构成中枢的笔数（≥3）
// @field startDir        进入中枢的方向（第一笔的方向）
type ZhongShu
    int             startStrokeIdx
    int             endStrokeIdx
    int             startOrigIndex
    int             endOrigIndex
    float           zg
    float           zd
    float           gg
    float           dd
    int             strokeCount
    StrokeDirection startDir

// @description 背驰类型：顶背驰（向上趋势末端）或底背驰（向下趋势末端）
enum BeiChiType
    NONE            // 无背驰
    TOP             // 顶背驰：价格新高，力度衰竭（向上趋势末端）
    BOTTOM          // 底背驰：价格新低，力度衰竭（向下趋势末端）

// @description 背驰信号：价格新高/新低但 MACD 力度衰竭
// @field strokeIndex   触发背驰的笔在 strokes 中的索引（离开段 b）
// @field refStrokeIndex 参考笔的索引（进入段 a）
// @field barIndex      背驰确认的原始 bar_index（离开段终点）
// @field currentArea   离开段 b 的 MACD 面积（绝对值）
// @field refArea       进入段 a 的 MACD 面积（绝对值）
// @field areaRatio     面积比 = currentArea / refArea（< 1 表示衰竭）
// @field bcType        顶背驰 or 底背驰
type BeiChiSignal
    int         strokeIndex
    int         refStrokeIndex
    int         barIndex
    float       currentArea
    float       refArea
    float       areaRatio
    BeiChiType  bcType

// @description 买卖点类型：B1/B2/B3（买点，绿色系）和 S1/S2/S3（卖点，红色系）
enum SignalType
    B1      // 第一类买点：下跌趋势底背驰后
    B2      // 第二类买点：B1 后回调不创新低
    B3      // 第三类买点：中枢上方回调不破 ZG
    S1      // 第一类卖点：上涨趋势顶背驰后（B1 的镜像）
    S2      // 第二类卖点：S1 后反弹不创新高（B2 的镜像）
    S3      // 第三类卖点：中枢下方反弹不破 ZD（B3 的镜像）

// @description 买卖点信号：结合中枢、背驰和笔的结构生成的交易信号
// @field barIndex    信号触发的原始 bar_index
// @field price       信号触发价格
// @field sType       信号类型 B1/B2/B3/S1/S2/S3
// @field refIndex    关联参考索引（B1/S1=趋势背驰stroke索引, B3/S3=中枢索引, B2/S2=B1/S1索引）
// @field description 信号描述文本（label 显示）
type TradingSignal
    int         barIndex
    float       price
    SignalType  sType
    int         refIndex
    string      description

// @description 实时预判条目：基于最新 M1-M5 状态的触发价格阈值计算
// @field signalType   预判的信号类型 "B1"/"B2"/"B3"/"S1"/"S2"/"S3"
// @field triggerPrice 触发价格阈值
// @field description  触发条件描述
// @field direction    价格需要突破的方向 ("UP"/"DOWN")
// @field statusText   预判生命周期状态："⏳ 等待中" / "⏳ 观察背驰" / "⏳ 形成中" / "✅ 已触发" / "❌ 已失效"
type Prediction
    string signalType
    float  triggerPrice
    string description
    string direction
    string statusText
    float  stopLoss       // M3: 参考止损价格（na = 未计算）

// ============================================================
// INPUT PARAMETERS
// ============================================================

// 调试开关：显示包含处理过程
bool showContainmentDebug = input.bool(false, "显示包含处理过程", group="调试", tooltip="开启后高亮被合并的K线，显示合并前后对比")
bool showFractalLabels    = input.bool(true,  "显示分型文字标签",  group="调试", tooltip="显示顶/底分型的文字标签。关闭后只保留三角标记")

