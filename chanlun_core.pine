bool  showStopLossInput           = input.bool(true,  "显示止损信息", group="止损设置",
    tooltip="在信号标签和预判面板中显示参考止损位。关闭后与 v0.8.0 行为一致")
int   stopLossAtrPeriodInput      = input.int(14,   "ATR 周期", minval=5, maxval=50, group="止损设置",
    tooltip="用于计算动态止损距离的 ATR 周期。14=约三周日线波动率")
float stopLossAtrMultiplierInput  = input.float(1.5, "ATR 倍数", minval=0.5, maxval=5.0, step=0.1, group="止损设置",
    tooltip="止损距离 = max(ATR×倍数, 价格×2%)。倍数越大止损越宽")

